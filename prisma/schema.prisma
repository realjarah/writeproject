generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model VoiceSample {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  wordCount Int      @default(0)
  category  String   @default("other")
  createdAt DateTime @default(now())
}

model VoiceProfile {
  id        Int      @id @default(autoincrement())
  analysis  String   // JSON: style traits, patterns, vocab notes
  updatedAt DateTime @updatedAt
}

model GeneratedContent {
  id          Int      @id @default(autoincrement())
  contentType String   // "blog" | "social" | "caption"
  topic       String
  interview   String   // JSON: interview Q&A
  content     String
  createdAt   DateTime @default(now())
}

model Signature {
  id        Int      @id @default(autoincrement())
  name      String
  content   String   // the footer text, supports markdown-ish formatting
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model GhostwriterJob {
  id          Int       @id @default(autoincrement())
  contentType String
  topic       String
  brief       String    // JSON: { interview, context?, signatureContent? }
  status      String    @default("queued") // queued|planning|drafting_1|drafting_2|drafting_3|comparing|checking|humanizing|done|error
  stepLabel   String    @default("")
  drafts      String    @default("[]")     // JSON array of up to 3 raw draft strings
  finalDraft  String    @default("")
  errorMsg    String    @default("")
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
