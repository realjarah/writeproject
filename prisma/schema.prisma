generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CustomContentType {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
}

model FavoriteWord {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word       String
  definition String   @default("")
  createdAt  DateTime @default(now())
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  passwordHash      String
  onboarded         Boolean  @default(false)
  accountType       String   @default("individual") // individual | brand
  onboardingProfile String   @default("{}") // JSON: { answers: [{question, answer}], submittedAt }
  createdAt         DateTime @default(now())

  voiceSamples     VoiceSample[]
  voiceProfile     VoiceProfile?
  signatures       Signature[]
  ghostwriterJobs  GhostwriterJob[]
  generatedContent GeneratedContent[]
  favoriteWords      FavoriteWord[]
  customContentTypes CustomContentType[]
  templates          Template[]
}

model VoiceSample {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  wordCount Int      @default(0)
  category  String   @default("other")
  createdAt DateTime @default(now())
}

model VoiceProfile {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis  String   // JSON: style traits, patterns, vocab notes
  updatedAt DateTime @updatedAt
}

model GeneratedContent {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType String
  topic       String
  interview   String   // JSON: interview Q&A
  content     String
  createdAt   DateTime @default(now())
}

model Signature {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  content   String   // the footer text, supports markdown-ish formatting
  isDefault Boolean  @default(false)
  isSystem  Boolean  @default(false)  // locked — cannot be edited or deleted
  createdAt DateTime @default(now())
}

model Template {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  contentType String
  brief       String   // JSON: template brief (interview fields + context items + signatureId)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GhostwriterJob {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType String
  topic       String
  title       String    @default("")
  summaryText String    @default("")
  brief       String    // JSON: { interview, context?, signatureContent? }
  status      String    @default("queued") // queued|planning|drafting_1|drafting_2|drafting_3|comparing|checking|humanizing|done|error
  stepLabel   String    @default("")
  drafts      String    @default("[]")     // JSON array of up to 3 raw draft strings
  finalDraft  String    @default("")
  errorMsg    String    @default("")
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
