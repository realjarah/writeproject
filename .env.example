ANTHROPIC_API_KEY=your_anthropic_api_key_here

# From Neon (neon.tech) — use the "pooled" connection string for DATABASE_URL
# and the "direct" connection string for DIRECT_URL
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
# Set to your deployment URL in production (e.g. https://yourapp.vercel.app)
NEXTAUTH_URL=http://localhost:3000
