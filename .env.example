ANTHROPIC_API_KEY=your_anthropic_api_key_here
XAI_API_KEY=your_xai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Optional — Jina Reader API for URL content extraction (free tier: 10M tokens)
# Get a key at https://jina.ai/reader/ for higher rate limits
JINA_API_KEY=

# From Neon (neon.tech) — use the "pooled" connection string for DATABASE_URL
# and the "direct" connection string for DIRECT_URL
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
# Set to your deployment URL in production (e.g. https://yourapp.vercel.app)
NEXTAUTH_URL=http://localhost:3000
